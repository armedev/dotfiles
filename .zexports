# ~/.zexports
# ---------------------------------------------------------------------------
# Exported environment: PATH additions and environment variables.
# Sourced from .zshenv, so it runs in EVERY zsh (login, interactive, tmux
# panes, scripts). It is sourced AGAIN from .zprofile right after Homebrew's
# `shellenv`, to keep these overrides ahead of Homebrew's defaults.
# Keep it cheap — no tool initialization and no command substitutions that
# spawn extra processes. It must be safe to run more than once.
# ---------------------------------------------------------------------------

# Tool-specific variables (must be set before their PATH entries below).
export BUN_INSTALL="$HOME/.bun"
export NVM_DIR="$HOME/.nvm"   # nvm itself is loaded in .zprofile

# Directories are listed highest-priority first — the first entry wins.
path_prepend \
  "$HOME/.local/bin"                                  \
  "$HOME/scripts"                                     \
  "$HOME/.opencode/bin"                               \
  "$HOME/.cargo/bin"                                  \
  "$HOME/go/bin"                                      \
  "/opt/homebrew/opt/ruby/bin"                        \
  "/opt/homebrew/opt/postgresql@16/bin"               \
  "$HOME/applications3party/flutter/bin"              \
  "$HOME/fvm/default/bin"                             \
  "$BUN_INSTALL/bin"
